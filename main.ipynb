        "### Text Feature Pipeline"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "853a305f",
      "metadata": {
        "id": "853a305f"
      },
      "source": [
        "#### Word Count Transformer\n",
        "In the text pipeline we will create two custom features. First one will count good and bad words already chosen like good, perfect or bad."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 5,
      "id": "e46b1bdb",
      "metadata": {
        "id": "e46b1bdb"
      },
      "outputs": [],
      "source": [
        "class WordCount(BaseEstimator, TransformerMixin):\n",
        "    def __init__(self, words: np.array):\n",
        "        self.words = words\n",
        "        return\n",
        "\n",
        "    def fit(self, X, y=None):\n",
        "        return self\n",
        "\n",
        "    def transform(self, X):\n",
        "        counts = []\n",
        "        for text_sample in X:\n",
        "            current_count = 0\n",
        "            for word in str(text_sample).split(\" \"):\n",
        "                if word in self.words:\n",
        "                    current_count += 1\n",
        "            counts.append(current_count)\n",
        "        return np.atleast_2d(np.array(counts).reshape(-1, 1))\n",
        "\n"
      ]
    },
