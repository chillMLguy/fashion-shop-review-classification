              "                ('feature_engineering',\n",
              "                 FeatureUnion(transformer_list=[('positive_words_count',\n",
              "                                                 WordCount(words=array(['good', 'perfect', 'awesome', 'love'], dtype='<U7'))),\n",
              "                                                ('negative_words_count',\n",
