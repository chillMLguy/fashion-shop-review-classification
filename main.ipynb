      "source": [
        "# Modelling clothing shop reviews\n",
        "\n",
        "In this notebook first we will split the data, then create pipelines for num, cat and text data. After that we will merge this pipelines and use ML models for predictions. At the end we will also fine tune our model."
      ]
    },
    {
      "cell_type": "markdown",
      "id": "90137b87",
      "metadata": {
        "id": "90137b87"
      },
      "source": [
        "## Libraries import and data preparation"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 1,
      "id": "ece67515",
      "metadata": {
        "id": "ece67515"
      },
      "outputs": [],
      "source": [
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "from sklearn.pipeline import Pipeline\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "import spacy\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.preprocessing import OrdinalEncoder\n",
        "from sklearn.preprocessing import OneHotEncoder\n",
        "from sklearn.base import BaseEstimator, TransformerMixin\n",
        "from transformers import AutoTokenizer, AutoModel\n",
        "import torch\n",
        "from sklearn.preprocessing import FunctionTransformer\n",
        "from sklearn.pipeline import FeatureUnion\n",
        "from sklearn.compose import ColumnTransformer\n",
        "from sklearn.metrics import accuracy_score\n",
        "from sklearn.metrics import confusion_matrix\n",
        "from sklearn.metrics import classification_report\n",
        "from sklearn.ensemble import RandomForestClassifier\n",
        "from sklearn.pipeline import make_pipeline\n",
        "from sklearn.model_selection import GridSearchCV\n",
        "\n",
        "nlp = spacy.load('en_core_web_sm')"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 2,
      "id": "2069a809",
      "metadata": {
        "id": "2069a809"
      },
      "outputs": [],
      "source": [
        "data = pd.read_csv(\"reviews.csv\")\n",
        "num_cols = [\"Age\", \"Positive Feedback Count\"]\n",
        "cat_cols = [\"Division Name\", \"Department Name\", \"Class Name\"]\n",
        "text_cols = [\"Review Text\"]\n",
        "data = data.drop([\"Clothing ID\"], axis=1)\n",
        "\n",
        "X = data.drop('Recommended IND', axis=1)\n",
        "y = data['Recommended IND'].copy()\n",
        "\n",
        "X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.1, shuffle=True, random_state=42)"
      ]
    },
